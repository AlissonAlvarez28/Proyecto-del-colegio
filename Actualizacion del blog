    <!-- LÓGICA DE COMENTARIOS DINÁMICOS -->
    <script>
        // Array inicial de comentarios
        let listaComentariosData = [
            {
                nombre: "Carlos Mendoza",
                rol: "Padre de Familia",
                mensaje: "Excelente labor de los docentes y la directiva del instituto. Los talleres técnicos están aportando mucho al futuro de nuestros jóvenes en Zambrano.",
                tiempo: "Hace 1 hora",
                estiloRol: "bg-amber-100 text-amber-900"
            },
            {
                nombre: "Andrea Gutiérrez",
                rol: "Estudiante de Informática",
                mensaje: "Orgullosa de formar parte del Bachillerato Técnico en Informática. ¡Saludos a todos los compañeros y profesores!",
                tiempo: "Hace 1 día",
                estiloRol: "bg-blue-100 text-blue-900"
            },
            {
                nombre: "Roberto Valladares",
                rol: "Exalumno",
                mensaje: "Grandes recuerdos de mi paso por el Francisco Miranda. La formación en los talleres me sirvió enormemente en mi carrera profesional.",
                tiempo: "Hace 2 días",
                estiloRol: "bg-emerald-100 text-emerald-900"
            }
        ];

        // Cargar comentarios guardados previamente en LocalStorage si existen
        function cargarComentarios() {
            const guardados = localStorage.getItem('igt_comentarios');
            if (guardados) {
                listaComentariosData = JSON.parse(guardados);
            }
            renderizarComentarios();
        }

        // Renderizar comentarios en la pantalla
        function renderizarComentarios() {
            const contenedor = document.getElementById('lista-comentarios');
            const contador = document.getElementById('total-comentarios');
            contenedor.innerHTML = '';

            contador.textContent = `${listaComentariosData.length} Comentarios`;

            listaComentariosData.forEach(com => {
                const item = document.createElement('div');
                item.className = "p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2 animate-fadeIn";
                item.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-bold text-slate-900 text-sm">${escapeHTML(com.nombre)}</h4>
                            <span class="inline-block ${com.estiloRol || 'bg-slate-200 text-slate-800'} text-[10px] font-bold px-2 py-0.5 rounded-md">${escapeHTML(com.rol)}</span>
                        </div>
                        <span class="text-[10px] text-slate-400 font-semibold"><i class="fa-regular fa-clock"></i> ${com.tiempo}</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">${escapeHTML(com.mensaje)}</p>
                `;
                contenedor.appendChild(item);
            });
        }

        // Publicar nuevo comentario
        function publicarComentario(e) {
            e.preventDefault();

            const nombre = document.getElementById('nombre-usuario').value.trim();
            const rol = document.getElementById('rol-usuario').value;
            const mensaje = document.getElementById('texto-comentario').value.trim();

            if (!nombre || !mensaje) return;

            // Determinar estilo según el rol
            let estiloRol = "bg-slate-200 text-slate-800";
            if (rol.includes('Estudiante')) estiloRol = "bg-blue-100 text-blue-900";
            else if (rol.includes('Padre')) estiloRol = "bg-amber-100 text-amber-900";
            else if (rol.includes('Exalumno')) estiloRol = "bg-emerald-100 text-emerald-900";
            else if (rol.includes('Docente')) estiloRol = "bg-purple-100 text-purple-900";

            const nuevoComentario = {
                nombre: nombre,
                rol: rol,
                mensaje: mensaje,
                tiempo: "Justo ahora",
                estiloRol: estiloRol
            };

            // Agregar al inicio del listado
            listaComentariosData.unshift(nuevoComentario);

            // Guardar en LocalStorage
            localStorage.setItem('igt_comentarios', JSON.stringify(listaComentariosData));

            // Actualizar vista y limpiar formulario
            renderizarComentarios();
            document.getElementById('form-comentario').reset();
        }

        // Función para evitar inyección de código
        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        window.addEventListener('DOMContentLoaded', cargarComentarios);
    </script>
</body>
</html>
