# Copiar como .env y rellenar. NUNCA subir el .env real a Git.

PORT=3000

# --- Base de datos (Aiven entrega estos datos en su panel) ---
DB_HOST=tu-servicio.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL_CA_PATH=./certs/ca.pem

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# --- Frontend permitido (separar con comas) ---
CORS_ORIGINS=http://localhost:5500,https://tu-sitio.netlify.app
